# Sao chép file này thành .env khi chạy local, hoặc nhập các biến này vào
# phần Environment Variables của dịch vụ hosting. KHÔNG commit giá trị thật.

APP_ENV=production

# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_URI=
# core/database.py đọc MONGO_DB_NAME (core/config.py đọc DATABASE_NAME) -> đặt cả hai cùng giá trị
MONGO_DB_NAME=Pomodoro_App
DATABASE_NAME=Pomodoro_App

# Chuỗi ngẫu nhiên >= 32 ký tự. Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

GOOGLE_WEB_CLIENT_ID=
GEMINI_API_KEY=
OPENWEATHER_API_KEY=

# Ngăn cách bằng dấu phẩy. Để trống/"*" = cho phép tất cả (chỉ cần cho web, app Android không cần)
CORS_ORIGINS=*
